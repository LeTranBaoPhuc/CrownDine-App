# CrownDine Environment Variables Example
# Copy this file to .env and fill in your values. Do NOT commit .env to Git!

# Google OAuth Client ID (Get from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=replace_me
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=replace_me
JWT_ACCESS_KEY=replace_with_base64_key_at_least_32_bytes
JWT_REFRESH_KEY=replace_with_another_base64_key_at_least_32_bytes
JWT_RESET_PASSWORD_KEY=replace_with_another_base64_key_at_least_32_bytes
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
PAYOS_CLIENT_ID=replace_me
PAYOS_API_KEY=replace_me
PAYOS_CHECKSUM_KEY=replace_me
GEMINI_API_KEY=replace_me
GEMINI_API_KEYS=replace_me
OPENROUTER_API_KEY=replace_me

# Docker MySQL credentials
MYSQL_PASSWORD=replace_me
MYSQL_ROOT_PASSWORD=replace_me_too
